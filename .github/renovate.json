{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "rebaseWhen": "behind-base-branch",
  "dependencyDashboard": true,
  "labels": ["dependencies"],
  "commitMessagePrefix": "⏫",
  "commitMessageTopic": "{{depName}}",
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["//Dockerfile$/", "//build.yaml$/"],
      "matchStringsStrategy": "any",
      "matchStrings": [
        "ARG BUILD_FROM=(?<depName>.*?):(?<currentValue>.*?)\\s+",
        "(aarch64|amd64|armhf|armv7|i386):\\s[\"']?(?<depName>.*?):(?<currentValue>.*?)[\"']?\\s"
      ],
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "dependencyDashboardApproval": true,
      "matchUpdateTypes": ["major"],
      "labels": ["UPDATE-MAJOR"]
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "groupName": "HomeAssistant Add-on base image",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^(?:ghcr.io/)?home-assistant/.*-base$/"]
    },
    {
      "groupName": "HomeAssistant hassio-addons debian base image",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^(?:ghcr.io/)?hassio-addons/debian-base/.*$/"]
    },
    {
      "groupName": "VictoriaMetrics",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^victoriametrics//"]
    },
    {
      "groupName": "linuxserver.io/syslog-ng",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^lscr.io/linuxserver/syslog-ng/"]
    },
    {
      "groupName": "linuxserver.io/healthchecks",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["/^lscr.io/linuxserver/healthchecks/"]
    }
  ]
}
